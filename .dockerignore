# Frontend .dockerignore
# ======================

# Dependencies
node_modules
npm-debug.log

# Build outputs
.next
out

# Development
.git
.gitignore
*.md
# Articles are markdown and are read at build time (src/lib/content.ts).
!content/**/*.md
.env.local
.env.development*

# IDE
.vscode
.idea
*.swp
*.swo

# Testing
coverage
.nyc_output

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Kubernetes
k8s/

# Backend sources stay IN the build context: src/lib/agent-knowledge.ts imports
# backend/knowledge/portfolio.json, and articles' `evidence:` paths (many under
# backend/) are checked to exist at build time. Excluding backend/ broke the
# image build. Nothing from it reaches the runner stage (standalone output only).
backend/.venv
backend/venv
backend/**/__pycache__
backend/htmlcov
backend/*.db

# Misc
.DS_Store
Thumbs.db
*.log
